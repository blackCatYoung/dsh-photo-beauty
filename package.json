{
  "name": "dsh-photo-beauty",
  "version": "0.4.3",
  "private": false,
  "description": "Local portrait retouch for DeepSeek Harness: skin smoothing, tone, slimming, eyes and makeup, plus deterministic on-device parameter suggestions.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSES/",
    "THIRD-PARTY-NOTICES.md",
    "lib/",
    "engine/beauty.py",
    "engine/requirements.txt",
    "engine/models/",
    "scripts/setup-engine.sh",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "engine/beauty_metrics.py",
    "skills/"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blackCatYoung/dsh-photo-beauty.git"
  },
  "homepage": "https://github.com/blackCatYoung/dsh-photo-beauty#readme",
  "bugs": {
    "url": "https://github.com/blackCatYoung/dsh-photo-beauty/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "portrait",
    "beauty",
    "retouch",
    "mediapipe",
    "opencv"
  ],
  "scripts": {
    "test": "node test/host-smoke.mjs && node test/client-smoke.mjs && node test/save-smoke.mjs && node test/multi-smoke.mjs && node test/ai-smoke.mjs",
    "test:engine": ".venv/bin/python -m unittest discover -s test",
    "preview": "node test/workbench-preview.mjs"
  }
}
